<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <Description>The ONNX-to-Python translation behind Shorokoo's Python-based backends: writes a Shorokoo graph (serialized ONNX) as a Python module calling a backend's support package. You normally do not install this directly; install a PyTorch or JAX backend package, which brings it.</Description>
    <PackageTags>shorokoo;python;onnx;backend;machine-learning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shorokoo\Shorokoo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shorokoo.PyTorch" />
    <InternalsVisibleTo Include="Shorokoo.Jax" />
    <InternalsVisibleTo Include="Shorokoo.Tests" />
  </ItemGroup>
</Project>
