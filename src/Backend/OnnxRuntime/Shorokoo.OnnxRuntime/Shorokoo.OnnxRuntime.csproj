<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <Description>ONNX Runtime backend glue for Shorokoo (managed, platform-neutral). You normally do not install this directly; install Shorokoo.LinuxCPU, Shorokoo.LinuxGPU, Shorokoo.WinCPU, or Shorokoo.WinGPU instead, which bring the native ONNX Runtime for your platform.</Description>
    <PackageTags>shorokoo;onnxruntime;backend;machine-learning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.26.0" />
  </ItemGroup>

  <!-- NuGet auto-imports build/<PackageId>.targets for a DIRECT PackageReference and
       buildTransitive/<PackageId>.targets for one that arrives through another package. Nobody
       references this package directly: it reaches a user through Shorokoo.LinuxCPU / LinuxGPU /
       WinCPU / WinGPU, so build/ alone never reached anyone, and a project declaring
       ShorokooBackendNatives items got no target to read them, an empty ort/ folder, and a
       FileNotFoundException at runtime with nothing said at build time. Packed to both, because
       either route is legitimate. It defines nothing unless a project declares those items. -->
  <ItemGroup>
    <None Include="build\Shorokoo.OnnxRuntime.targets" Pack="true"
          PackagePath="build/Shorokoo.OnnxRuntime.targets;buildTransitive/Shorokoo.OnnxRuntime.targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shorokoo\Shorokoo.csproj" />
  </ItemGroup>

  <!-- The arena-statistics binding reaches ONNX Runtime by reflection, so the guard that fails
       loudly on an ORT upgrade has to name the very strings the binding uses rather than a copy
       of them that could drift. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Shorokoo.Tests" />
  </ItemGroup>
</Project>
