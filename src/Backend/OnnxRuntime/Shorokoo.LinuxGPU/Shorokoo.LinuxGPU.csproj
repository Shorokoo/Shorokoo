<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <Description>Shorokoo execution backend for Linux x64 GPU (CUDA), powered by ONNX Runtime. Install alongside the Shorokoo package.</Description>
    <PackageTags>shorokoo;onnxruntime;backend;linux;gpu;cuda;machine-learning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shorokoo.OnnxRuntime\Shorokoo.OnnxRuntime.csproj" />
  </ItemGroup>

  <!-- The CUDA build of Shorokoo's operators (native/shorokoo_adam_update.cu in
       Shorokoo.OnnxRuntime), which a CUDA session registers to run each Adam or AdamW update as one
       kernel, shipped beside ONNX Runtime's CUDA provider. A pack on Linux takes the library its
       own build of Shorokoo.OnnxRuntime made (with a CUDA toolkit at hand; see -p:ShorokooCudaOps);
       a pack on another platform takes it from linux-x64/ under -p:ShorokooNativeAllocators=<folder>,
       as Shorokoo.OnnxRuntime takes the other platform's allocator. The package is never packed
       without it. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeShorokooCudaOperators</TargetsForTfmSpecificContentInPackage>
    <ShorokooCudaOperators Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(MSBuildThisFileDirectory)../Shorokoo.OnnxRuntime/obj/native/linux-x64/libshorokoo_ort_cuda_ops.so</ShorokooCudaOperators>
    <ShorokooCudaOperators Condition="!$([MSBuild]::IsOSPlatform('Linux')) and '$(ShorokooNativeAllocators)' != ''">$(ShorokooNativeAllocators)/linux-x64/libshorokoo_ort_cuda_ops.so</ShorokooCudaOperators>
  </PropertyGroup>

  <Target Name="IncludeShorokooCudaOperators">
    <Error Condition="'$(ShorokooCudaOperators)' == '' or !Exists('$(ShorokooCudaOperators)')"
           Text="The Shorokoo.LinuxGPU package carries the CUDA build of Shorokoo's operators (libshorokoo_ort_cuda_ops.so), and it was not found ('$(ShorokooCudaOperators)'). On Linux, build with a CUDA 13 toolkit and -p:ShorokooCudaOps=ON; on another platform, build the native folder on Linux with cmake (-DSHOROKOO_CUDA_OPS=ON -DSHOROKOO_OUTPUT_DIR=&lt;folder&gt;/linux-x64) and pack with -p:ShorokooNativeAllocators=&lt;folder&gt;." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(ShorokooCudaOperators)" PackagePath="runtimes/linux-x64/native/" />
    </ItemGroup>
  </Target>
</Project>
