<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <!-- Published as "Shorokoo.Core"; the assembly/namespace stay "Shorokoo". -->
    <ShorokooPackageName>Shorokoo.Core</ShorokooPackageName>
    <Description>Core runtime for Shorokoo: a .NET deep-learning framework with strongly typed tensors, reverse-mode autodiff, and ONNX interop (export .onnx, load .safetensors). Most users want the 'Shorokoo' meta-package (which also brings the [Module] source generator); then add a backend for each device you want to run on: Shorokoo.LinuxCPU, Shorokoo.LinuxGPU, Shorokoo.WinCPU, or Shorokoo.WinGPU. One is enough, and a program that names its backends may load several.</Description>
    <PackageTags>machine-learning;deep-learning;neural-network;tensor;autodiff;onnx;training;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <PackageReference Include="RandN" Version="0.4.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shorokoo.CodeGen\Shorokoo.CodeGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The NVIDIA libraries every CUDA backend shares are pinned beside the lock of the CUDA Python
       environment, whose PyTorch carries the same releases, and read from here: one file, so the two
       cannot drift apart. The logical name is "CudaLibraries/cu13/<rid>/cuda-libraries.txt". -->
  <ItemGroup>
    <EmbeddedResource Include="..\Backend\Python\Shorokoo.PythonHost\Environments\cu13\**\cuda-libraries.txt"
                      LogicalName="CudaLibraries/cu13/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shorokoo.Tests" />
    <!-- The ONNX Runtime backends hand the process's allocator (Core/Backends/CachingAllocator.cs) to
         their runtimes; every copy of a backend has to reach the one in this assembly. -->
    <InternalsVisibleTo Include="Shorokoo.OnnxRuntime" />
    <InternalsVisibleTo Include="Shorokoo.PythonHost" />
    <!-- A backend that places a run's outputs in the memory of what the run consumed proves the
         placements and hands back values standing on a shared block (Core/Backends/PlacementProof.cs,
         Core/Backends/SharedBlock.cs), which are this assembly's. -->
    <InternalsVisibleTo Include="Shorokoo.PyTorch" />
    <!-- A backend's host values address a piece of their own buffer for the range copies
         (Core/Backends/IShorokooTensorValue.cs, HostPiece), which is how one longer than a span is
         saved and loaded. -->
    <InternalsVisibleTo Include="Shorokoo.Jax" />
  </ItemGroup>
</Project>
