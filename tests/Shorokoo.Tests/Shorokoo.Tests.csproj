<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Benchmarks/perf-baseline.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Benchmarks/memory-pass-baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- For the MSG004 Rng.Pin-suggestion unit tests, which parse module snippets and drive
         the generator's suggestion builder directly (version aligned with the transitive
         Shorokoo.Core dependency; the generator targets 4.8.0, and Roslyn is back-compatible). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

  <!--
    Shorokoo no longer depends on ONNX Runtime directly. The platform-specific
    backend is supplied by referencing exactly one Shorokoo.{Platform}
    project: Shorokoo.WinCPU, Shorokoo.WinGPU, or Shorokoo.LinuxCPU. Each ships
    its own ORT NuGet (with native libs) into bin; on first run,
    DefaultBackend auto-discovers that DLL in the output folder (tests don't set
    it explicitly, so the discovery fallback is exercised).

    On this Linux sandbox we reference Shorokoo.LinuxCPU. On a Windows dev box
    swap the ProjectReference for Shorokoo.WinCPU or Shorokoo.WinGPU.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <ProjectReference Include="..\..\src\Backend\OnnxRuntime\Shorokoo.LinuxCPU\Shorokoo.LinuxCPU.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(ShorokooGpuTests)' != 'true'">
    <ProjectReference Include="..\..\src\Backend\OnnxRuntime\Shorokoo.WinCPU\Shorokoo.WinCPU.csproj" />
  </ItemGroup>

  <!--
    -p:ShorokooGpuTests=true deploys Shorokoo.WinGPU as the default backend instead of
    Shorokoo.WinCPU, which is what CudaFactAttribute gates on: it skips unless the discovered
    backend's assembly name ends in "GPU". Opt-in rather than the default, because a CPU-only
    Windows box (CI included) has no card and would fail every one of those tests instead of
    skipping them. Exactly one of the two deploys, since two backend assemblies side by side are
    what DefaultBackend's discovery refuses.

    PAIR IT WITH THE Purpose=Hardware FILTER, AND NOTHING ELSE. It changes the PROCESS-WIDE default
    backend, and the coverage suite is written against a host one: a literal built with TensorData
    is a host tensor, an Execute output is read back with a span, CompiledGraph.OutputPlacement is
    Host, and SideBySideBackendCoverageTests deliberately pairs the stock CPU backend against an
    isolated runtime, naming Shorokoo.WinCPU, which does not deploy here at all. Run the coverage
    filter under this flag and about twenty of those tests fail, every one of them correctly: the
    product is refusing to read device memory from the host. They are the suite's own CPU-shaped assumptions, not a fault on
    the device, and making them device-agnostic would buy nothing: the card's behaviour is what
    Purpose=Hardware is for, and CI has no card to run either half on.

    Within Purpose=Hardware it is GpuExecutionTests that wants it. SideBySideBackendHardwareTests
    wants the opposite, a host default backend beside an isolated CUDA one, so it needs
    ShorokooDeployGpuBackend on its own. Each class skips out of the other's build and says why, so
    a Purpose=Hardware run is green either way; to run both, run it twice.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(ShorokooGpuTests)' == 'true'">
    <ProjectReference Include="..\..\src\Backend\OnnxRuntime\Shorokoo.WinGPU\Shorokoo.WinGPU.csproj" />
  </ItemGroup>

  <!--
    The OTHER platform's backend, built but not deployed. BackendPackageTests probes it to prove a
    backend for the wrong operating system is turned away with a reason rather than an exception,
    which needs the assembly to exist and needs it kept out of the output folder (deployed, it
    would be a second discovery candidate). ReferenceOutputAssembly="false" gives exactly that:
    the project is built, nothing of it is copied.

    Without this the tests read a bin/ that a plain checkout never fills, so they failed on any
    machine that had not happened to build the whole solution (CI included), saying nothing
    about the product.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Backend\OnnxRuntime\Shorokoo.WinCPU\Shorokoo.WinCPU.csproj"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\Backend\OnnxRuntime\Shorokoo.LinuxCPU\Shorokoo.LinuxCPU.csproj"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    A second native ONNX Runtime, deployed under ort/cuda/, for the side-by-side backend tests.
    They need a runtime separate from the one the default backend above loaded, and a folder of
    its own is what makes it separate: both packages deliver their library at the same
    runtimes/<rid>/native/ path, so two of them deployed normally are one of them deployed twice.

    It is the CUDA-flavoured build, which carries the CPU execution provider as well as the CUDA
    one. So it runs here, on a machine with no GPU, under the CPU provider, and it is the same
    file that serves the CUDA provider on a machine with a card. Its provider libraries are left
    out: libonnxruntime_providers_cuda.so alone is some 340 MB, and only the hardware tests
    append that provider.

    ExcludeAssets="all" keeps this from competing for the output path with the CPU native the
    ProjectReference above deploys; the package is already restored by the solution, since
    Shorokoo.LinuxGPU references it, so this costs a file copy and no download.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.26.0"
                      ExcludeAssets="all" GeneratePathProperty="true" />
    <ShorokooBackendNatives BackendId="cuda" Condition="'$(ShorokooDeployGpuBackend)' != 'true'"
      Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Linux)\runtimes\linux-x64\native\libonnxruntime.so;$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Linux)\runtimes\linux-x64\native\libonnxruntime_providers_shared.so" />
  </ItemGroup>

  <!-- The same arrangement on Windows: the CUDA-flavoured onnxruntime.dll under ort/cuda/, a
       second runtime beside the stock CPU one the WinCPU reference deploys. Without
       ShorokooDeployGpuBackend the CUDA provider's own DLL is left out, exactly as on Linux. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.26.0"
                      ExcludeAssets="all" GeneratePathProperty="true" />
    <ShorokooBackendNatives BackendId="cuda" Condition="'$(ShorokooDeployGpuBackend)' != 'true'"
      Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\runtimes\win-x64\native\onnxruntime.dll;$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\runtimes\win-x64\native\onnxruntime_providers_shared.dll" />
  </ItemGroup>

  <!--
    -p:ShorokooDeployGpuBackend=true completes ort/cuda/ into a CUDA backend that can actually be
    loaded: the whole native set (the CUDA provider included, which is why this is opt-in) plus
    the Shorokoo.LinuxGPU backend assembly. That is what SideBySideBackendHardwareTests needs, and
    what a program driving the CPU and the card at once deploys.

    The backend goes into ort/cuda/ rather than beside Shorokoo.dll on purpose. Two backend
    assemblies side by side are exactly what DefaultBackend's discovery refuses, since a program
    that deployed both and named neither has not said which it means, and every other test here
    relies on discovery finding the CPU one. Under ort/cuda/ it is out of discovery's way and the
    spec's ProbeDirectory points at it. It is built through an MSBuild task rather than referenced,
    for the same reason: a ProjectReference deploys its output beside Shorokoo.dll whatever the
    metadata says, and brings its native package along to compete for the ordinary output path.
  -->
  <ItemGroup Condition="'$(ShorokooDeployGpuBackend)' == 'true' AND $([MSBuild]::IsOSPlatform('Linux'))">
    <ShorokooBackendNatives BackendId="cuda"
      Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Linux)\runtimes\linux-x64\native\*" />
  </ItemGroup>

  <ItemGroup Condition="'$(ShorokooDeployGpuBackend)' == 'true' AND $([MSBuild]::IsOSPlatform('Windows'))">
    <ShorokooBackendNatives BackendId="cuda"
      Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\runtimes\win-x64\native\*" />
  </ItemGroup>

  <Target Name="ShorokooDeployGpuBackendAssembly" AfterTargets="Build"
          Condition="'$(ShorokooDeployGpuBackend)' == 'true' AND $([MSBuild]::IsOSPlatform('Linux'))">
    <MSBuild Projects="..\..\src\Backend\OnnxRuntime\Shorokoo.LinuxGPU\Shorokoo.LinuxGPU.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ShorokooGpuBackendAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(ShorokooGpuBackendAssembly)" DestinationFolder="$(OutDir)ort\cuda"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ShorokooDeployGpuBackendAssemblyWindows" AfterTargets="Build"
          Condition="'$(ShorokooDeployGpuBackend)' == 'true' AND $([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="..\..\src\Backend\OnnxRuntime\Shorokoo.WinGPU\Shorokoo.WinGPU.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ShorokooGpuBackendAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(ShorokooGpuBackendAssembly)" DestinationFolder="$(OutDir)ort\cuda"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="..\..\src\Backend\OnnxRuntime\Shorokoo.OnnxRuntime\build\Shorokoo.OnnxRuntime.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shorokoo\Shorokoo.csproj" />
    <ProjectReference Include="..\..\src\Shorokoo.Modules\Shorokoo.Modules.csproj" />
    <!-- Referenced both as the analyzer that generates the [Module] wrappers AND as an
         ordinary assembly so the MSG004 suggestion builder can be unit-tested directly. -->
    <ProjectReference Include="..\..\src\Shorokoo.CodeGen\Shorokoo.CodeGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\..\samples\RetinaNet\RetinaNet.csproj" />
  </ItemGroup>

</Project>
