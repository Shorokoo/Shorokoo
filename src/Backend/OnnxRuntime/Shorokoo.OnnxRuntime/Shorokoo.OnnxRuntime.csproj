<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <Description>ONNX Runtime backend glue for Shorokoo (managed, platform-neutral). You normally do not install this directly; install Shorokoo.LinuxCPU, Shorokoo.LinuxGPU, Shorokoo.WinCPU, or Shorokoo.WinGPU instead, which bring the native ONNX Runtime for your platform.</Description>
    <PackageTags>shorokoo;onnxruntime;backend;machine-learning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" />
    <!-- For ONNX Runtime's C API header alone, which the native library is compiled against; none
         of the package's assets reach this assembly or its package. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- NuGet auto-imports build/<PackageId>.targets for a DIRECT PackageReference and
       buildTransitive/<PackageId>.targets for one that arrives through another package. Nobody
       references this package directly: it reaches a user through Shorokoo.LinuxCPU / LinuxGPU /
       WinCPU / WinGPU, so build/ alone never reached anyone, and a project declaring
       ShorokooBackendNatives items got no target to read them, an empty ort/ folder, and a
       FileNotFoundException at runtime with nothing said at build time. Packed to both, because
       either route is legitimate. It defines nothing unless a project declares those items. -->
  <ItemGroup>
    <None Include="build\Shorokoo.OnnxRuntime.targets" Pack="true"
          PackagePath="build/Shorokoo.OnnxRuntime.targets;buildTransitive/Shorokoo.OnnxRuntime.targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shorokoo\Shorokoo.csproj" />
  </ItemGroup>

  <!-- The native library: the allocator every session allocates through
       (native/shorokoo_ort_allocator.cpp) and the operators a CPU session registers
       (native/shorokoo_ort_ops.cpp), built with CMake for the platform the build runs on. It lands under runtimes/<rid>/native in
       the output, beside where ONNX Runtime's own natives go, and is found there by
       NativeAllocator.cs; the package carries it for every platform the backends target, under
       the same path. -->
  <PropertyGroup>
    <ShorokooAllocatorRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</ShorokooAllocatorRid>
    <ShorokooAllocatorRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</ShorokooAllocatorRid>
    <ShorokooAllocatorFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">shorokoo_ort_allocator.dll</ShorokooAllocatorFile>
    <ShorokooAllocatorFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">libshorokoo_ort_allocator.so</ShorokooAllocatorFile>
    <ShorokooAllocatorSource>$(MSBuildProjectDirectory)/native</ShorokooAllocatorSource>
    <ShorokooAllocatorBuildDir>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), 'native', 'build').TrimEnd('\/'))</ShorokooAllocatorBuildDir>
    <ShorokooAllocatorOutDir>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), 'native', $(ShorokooAllocatorRid)).TrimEnd('\/'))</ShorokooAllocatorOutDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(ShorokooAllocatorRid)' != ''">
    <None Include="$(ShorokooAllocatorOutDir)/$(ShorokooAllocatorFile)"
          Link="runtimes/$(ShorokooAllocatorRid)/native/$(ShorokooAllocatorFile)"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="runtimes/$(ShorokooAllocatorRid)/native/" />
  </ItemGroup>

  <!-- The CUDA build of the operators (native/shorokoo_adam_update.cu), which a CUDA session
       registers in place of the CPU one: built where CMake finds a CUDA toolkit of ONNX Runtime's
       GPU package's major version and an nvcc that compiles the kernel with a host compiler at
       hand (-p:ShorokooCudaOps=AUTO, the default; ON requires it and fails the build saying what is
       missing; OFF leaves it out), and copied beside the allocator where it was built.
       -p:ShorokooCudaHostCompiler=<cl.exe folder or g++ path> names nvcc's host compiler outright.
       Not packed here: the GPU backend packages, Shorokoo.WinGPU and Shorokoo.LinuxGPU, carry it,
       as they carry ONNX Runtime's CUDA provider. -->
  <PropertyGroup>
    <ShorokooCudaOps Condition="'$(ShorokooCudaOps)' == ''">AUTO</ShorokooCudaOps>
    <ShorokooCudaOpsFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">shorokoo_ort_cuda_ops.dll</ShorokooCudaOpsFile>
    <ShorokooCudaOpsFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">libshorokoo_ort_cuda_ops.so</ShorokooCudaOpsFile>
    <!-- The settings the native build was configured with, an input of it, so that changing one
         configures it again rather than leaving the last build's library in place. -->
    <ShorokooNativeSettingsFile>$(ShorokooAllocatorBuildDir).settings</ShorokooNativeSettingsFile>
  </PropertyGroup>

  <Target Name="RecordShorokooNativeSettings" BeforeTargets="BuildShorokooAllocator" Condition="'$(ShorokooAllocatorRid)' != ''">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ShorokooNativeSettingsFile)'))" />
    <WriteLinesToFile File="$(ShorokooNativeSettingsFile)" Lines="ShorokooCudaOps=$(ShorokooCudaOps);ShorokooCudaHostCompiler=$(ShorokooCudaHostCompiler)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="IncludeShorokooCudaOperators" AfterTargets="BuildShorokooAllocator" Condition="'$(ShorokooAllocatorRid)' != ''">
    <ItemGroup>
      <None Include="$(ShorokooAllocatorOutDir)/$(ShorokooCudaOpsFile)"
            Condition="Exists('$(ShorokooAllocatorOutDir)/$(ShorokooCudaOpsFile)')"
            Link="runtimes/$(ShorokooAllocatorRid)/native/$(ShorokooCudaOpsFile)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false" />
    </ItemGroup>
  </Target>

  <!-- The other platform's library, built there, for the package: a folder holding
       <rid>/<library>, as the release workflow assembles it. -->
  <ItemGroup Condition="'$(ShorokooNativeAllocators)' != ''">
    <None Condition="'$(ShorokooAllocatorRid)' != 'win-x64'"
          Include="$(ShorokooNativeAllocators)/win-x64/shorokoo_ort_allocator.dll"
          Visible="false" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Condition="'$(ShorokooAllocatorRid)' != 'linux-x64'"
          Include="$(ShorokooNativeAllocators)/linux-x64/libshorokoo_ort_allocator.so"
          Visible="false" Pack="true" PackagePath="runtimes/linux-x64/native/" />
  </ItemGroup>

  <!-- CMake: the one Visual Studio installs with its C++ tools where there is one, which knows that
       Visual Studio's generator; otherwise whatever is on the PATH. -p:ShorokooCMake=&lt;path&gt; names one
       outright. -->
  <Target Name="LocateShorokooCMake" Condition="'$(ShorokooCMake)' == '' and '$(ShorokooAllocatorRid)' != ''">
    <PropertyGroup>
      <_ShorokooVsWhere>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_ShorokooVsWhere>
    </PropertyGroup>
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(_ShorokooVsWhere)')"
          Command="&quot;$(_ShorokooVsWhere)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ShorokooVsCMake" />
    </Exec>
    <PropertyGroup>
      <ShorokooCMake Condition="'$(_ShorokooVsCMake)' != '' and Exists('$(_ShorokooVsCMake)')">$(_ShorokooVsCMake)</ShorokooCMake>
      <ShorokooCMake Condition="'$(ShorokooCMake)' == ''">cmake</ShorokooCMake>
    </PropertyGroup>
  </Target>

  <Target Name="BuildShorokooAllocator"
          Condition="'$(ShorokooAllocatorRid)' != ''"
          DependsOnTargets="LocateShorokooCMake"
          BeforeTargets="BeforeBuild"
          Inputs="$(ShorokooNativeSettingsFile);$(ShorokooAllocatorSource)/shorokoo_ort_allocator.cpp;$(ShorokooAllocatorSource)/shorokoo_ort_ops.cpp;$(ShorokooAllocatorSource)/shorokoo_adam_update.cu;$(ShorokooAllocatorSource)/shorokoo_adam_update.h;$(ShorokooAllocatorSource)/CMakeLists.txt;$(PkgMicrosoft_ML_OnnxRuntime)/build/native/include/onnxruntime_c_api.h"
          Outputs="$(ShorokooAllocatorOutDir)/$(ShorokooAllocatorFile)">
    <Exec Command="&quot;$(ShorokooCMake)&quot; --version" ConsoleToMSBuild="true" StandardOutputImportance="low"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_ShorokooCMakeFound" />
    </Exec>
    <Error Condition="'$(_ShorokooCMakeFound)' != '0'"
           Text="Shorokoo.OnnxRuntime builds a native library of its own, which takes CMake and a C++ compiler, and '$(ShorokooCMake)' did not run. On Windows, install Visual Studio (2019 or later, the Build Tools will do) with its C++ workload, which brings both; on Linux, install cmake and g++. Or name a CMake with -p:ShorokooCMake=&lt;path&gt;." />
    <Exec Command="&quot;$(ShorokooCMake)&quot; -S &quot;$(ShorokooAllocatorSource)&quot; -B &quot;$(ShorokooAllocatorBuildDir)&quot; -DSHOROKOO_OUTPUT_DIR=&quot;$(ShorokooAllocatorOutDir)&quot; -DSHOROKOO_ORT_INCLUDE_DIR=&quot;$(PkgMicrosoft_ML_OnnxRuntime)/build/native/include&quot; -DSHOROKOO_CUDA_OPS=$(ShorokooCudaOps) -DSHOROKOO_CUDA_HOST_COMPILER=&quot;$(ShorokooCudaHostCompiler)&quot;"
          StandardOutputImportance="low" StandardErrorImportance="high" />
    <Exec Command="&quot;$(ShorokooCMake)&quot; --build &quot;$(ShorokooAllocatorBuildDir)&quot; --config Release"
          StandardOutputImportance="low" />
    <!-- Newer than every input, which a build with nothing to recompile leaves it otherwise. -->
    <Touch Files="$(ShorokooAllocatorOutDir)/$(ShorokooAllocatorFile)" />
  </Target>

  <Target Name="RequireEveryShorokooAllocator" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ShorokooAllocatorWin Condition="'$(ShorokooAllocatorRid)' == 'win-x64'">$(ShorokooAllocatorOutDir)/shorokoo_ort_allocator.dll</_ShorokooAllocatorWin>
      <_ShorokooAllocatorWin Condition="'$(ShorokooAllocatorRid)' != 'win-x64'">$(ShorokooNativeAllocators)/win-x64/shorokoo_ort_allocator.dll</_ShorokooAllocatorWin>
      <_ShorokooAllocatorLinux Condition="'$(ShorokooAllocatorRid)' == 'linux-x64'">$(ShorokooAllocatorOutDir)/libshorokoo_ort_allocator.so</_ShorokooAllocatorLinux>
      <_ShorokooAllocatorLinux Condition="'$(ShorokooAllocatorRid)' != 'linux-x64'">$(ShorokooNativeAllocators)/linux-x64/libshorokoo_ort_allocator.so</_ShorokooAllocatorLinux>
    </PropertyGroup>
    <Error Condition="'$(ShorokooNativeAllocators)' == '' or !Exists('$(_ShorokooAllocatorWin)') or !Exists('$(_ShorokooAllocatorLinux)')"
           Text="The Shorokoo.OnnxRuntime package carries its native allocator for win-x64 and for linux-x64, and a build makes only its own platform's. Build the other on its platform (cmake -S native -B build -DSHOROKOO_OUTPUT_DIR=&lt;folder&gt;/&lt;rid&gt; -DSHOROKOO_ORT_INCLUDE_DIR=&lt;ONNX Runtime include folder&gt;, then cmake --build build --config Release) and pack with -p:ShorokooNativeAllocators=&lt;folder&gt;." />
  </Target>

  <!-- The arena-statistics binding reaches ONNX Runtime by reflection, so the guard that fails
       loudly on an ORT upgrade has to name the very strings the binding uses rather than a copy
       of them that could drift. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Shorokoo.Tests" />
  </ItemGroup>
</Project>
