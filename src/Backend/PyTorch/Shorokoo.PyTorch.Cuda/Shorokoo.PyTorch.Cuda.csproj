<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <Description>Shorokoo execution backend running on an NVIDIA GPU through PyTorch (CUDA 13), in an embedded CPython. The Python environment (torch for CUDA 13) is provisioned with uv on first use, or named with SHOROKOO_PYTHON_ENV. Install alongside the Shorokoo package and name it explicitly: new ComputeContext(new TorchCudaBackend()).</Description>
    <PackageTags>shorokoo;pytorch;torch;backend;linux;cuda;machine-learning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shorokoo.PyTorch\Shorokoo.PyTorch.csproj" />
  </ItemGroup>
</Project>
