<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <Description>The embedded CPython host behind Shorokoo's Python-based backends: finds or provisions the Python environment a backend needs (with uv, from a lock file), starts one interpreter per process through pythonnet, and keeps the GIL discipline. You normally do not install this directly; install Shorokoo.PyTorch.Cpu or Shorokoo.PyTorch.Cuda.</Description>
    <PackageTags>shorokoo;python;pythonnet;backend;machine-learning</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.1.0" />
  </ItemGroup>

  <!-- The lock files travel inside the assembly, so an environment is always provisioned from the
       exact lock the backend was built and tested against: one per environment and platform, each
       in a folder named by the platform's runtime identifier. The logical name is the path with
       forward slashes whatever the build machine's separator, e.g.
       "Environments/cpu/win-x64/requirements.txt"; RecursiveDir carries backslashes on Windows. -->
  <ItemGroup>
    <EmbeddedResource Include="Environments\**\*.txt" LogicalName="Environments/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <None Include="Environments\**\*.in" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shorokoo.PyTorch" />
    <InternalsVisibleTo Include="Shorokoo.Tests" />
  </ItemGroup>
</Project>
